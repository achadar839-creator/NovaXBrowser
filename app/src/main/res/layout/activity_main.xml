<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:id="@+id/browserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0D14"
        android:padding="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Infer Browser"
            android:textColor="#58A6FF"
            android:textStyle="bold"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnAdminPanel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="⚙️ Admin"
            android:textSize="10sp"
            android:textColor="#161B22"
            android:backgroundTint="#26FFFFFF"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="👤 Account"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#26FFFFFF"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btnVipAd"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🎬 VIP Ad"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#26FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/novax_glass_surface"
        android:padding="7dp"
        android:layout_margin="6dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvMiniPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎵 Playing in Background..."
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnMiniPrevious"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="⏪"
            android:backgroundTint="#55FFFFFF"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnMiniNext"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:text="⏩"
            android:backgroundTint="#55FFFFFF"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnMiniPlayPause"
            android:layout_width="68dp"
            android:layout_height="32dp"
            android:text="⏯️ Play"
            android:textSize="10sp"
            android:backgroundTint="#55FFFFFF"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnMiniClose"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:text="✖"
            android:textSize="10sp"
            android:backgroundTint="#66DA3633"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1117"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0D14"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">
            <Button
                android:id="@+id/btnWallpaper"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🎨 4K Photo/Video Theme"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#26FFFFFF"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnBookmarks"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🔖 Bookmarks"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#26FFFFFF"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnHistory"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🕘 History"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#26FFFFFF"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/btnQuickLinks"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🌐 Links"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btnClearData"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🗑 Clear"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btnDownloads"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📥 Downloads"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="⚙ Settings"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/btnDesktopMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desktop Mode" />
        <Button
            android:id="@+id/btnWebsiteTools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Website Tools" />
        <Button
            android:id="@+id/btnSharePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share Page" />
        <Button
            android:id="@+id/btnQrScanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR Scanner" />
        <Button
            android:id="@+id/btnRestoreSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restore Session" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read Aloud" />
        <Button
            android:id="@+id/btnFindPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find in Page" />
        <Button
            android:id="@+id/btnReadingMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading Mode" />
        <Button
            android:id="@+id/btnSearchEngine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Engine" />


            <Button
                android:id="@+id/btnIncognito"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🕵 Private"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btnPinAudio"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📌 Pin Audio"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#21262D"
                android:textColor="#C9D1D9" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1117"
        android:padding="6dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="⬅"
            android:contentDescription="Back"
            android:backgroundTint="#21262D"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnForward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:text="➡"
            android:contentDescription="Forward"
            android:backgroundTint="#21262D"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="42dp"
            android:text="🏠"
            android:backgroundTint="#21262D"
            android:textColor="#FFFFFF" />
        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="#0A0D14"
            android:hint="Search URL..."
            android:textColorHint="#8B949E"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:singleLine="true"
            android:inputType="textUri" />
        <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="⟳"
                android:textSize="18sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#26354D"
                android:textColor="#FFFFFF" />
            <Button
            android:id="@+id/btnGo"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:text="GO"
            android:backgroundTint="#26FFFFFF"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnTabs"
            android:layout_width="54dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:text="[ 1 ]"
            android:textStyle="bold"
            android:backgroundTint="#26FFFFFF"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
<Button
        android:id="@+id/btnUiToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="☰"
        android:contentDescription="Toggle browser bars"
        android:layout_gravity="end|center_vertical"
        android:elevation="16dp"
        android:backgroundTint="#26FFFFFF"
        android:textColor="#FFFFFF" />
</FrameLayout>
